aws_region = "us-east-1"

# Good starting point for a small friend server. Use m7a.2xlarge for more players.
instance_type = "m7a.xlarge"
volume_size_gb = 150

# Change this if your SSH key lives elsewhere.
ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# Strongly recommended: replace this with your public IP, e.g. ["203.0.113.10/32"].
ssh_cidr_blocks = ["0.0.0.0/0"]

# Public Minecraft server. Restrict this to player IPs if you want a private server.
allowed_minecraft_cidr_blocks = ["0.0.0.0/0"]

atm10_version = "7.0"
atm10_server_zip_url = "https://edge.forgecdn.net/files/8094/893/ServerFiles-7.0.zip"

memory_min = "8G"
memory_max = "12G"
motd = "ATM10 + Stellaris Space Server"

# Only these Minecraft accounts can join. Leave empty only if you want nobody
# to be able to join until the whitelist is updated.
minecraft_whitelist = [
  "YourMinecraftName",
]
